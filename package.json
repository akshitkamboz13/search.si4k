{
  "name": "si4k-search",
  "version": "1.0.0",
  "description": "Unified offline-first knowledge search engine",
  "main": "dist/server/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"tsx watch src/server/index.ts\"",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build:zim-index": "tsx scripts/build-zim-index.ts",
    "build": "npm run build:zim-index && npm run build:client && npm run build:server",
    "start": "node dist/server/index.js",
    "test": "tsx src/server/search/queryRouting.test.ts && tsx src/server/search/zimIndexer.test.ts && tsx src/server/search/progressiveSearch.test.ts && tsx src/server/search/zimDiscovery.test.ts && tsx src/server/search/providers/KiwixProvider.test.ts && tsx src/server/search/searchEngineFull.test.ts"
  },
  "dependencies": {
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "lucide-react": "^0.395.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "tsx": "^4.15.7",
    "typescript": "^5.4.5",
    "vite": "^5.3.1"
  }
}
